+CENT = D("0.01")
+
+
+def share_in_cents(amount, quantity):
+    """
+    Split an amount in cents over ``quantity`` units: every unit gets the same
+    price in cents and the first ``extra`` units one cent more, so that the
+    unit prices add up to the amount exactly.  Returns ``(price, extra)``.
+    """
+    cents, extra = divmod(int(amount / CENT), quantity)
+    return cents * CENT, extra
+
+
+def unit_price_rows(breakdown, line_incl_tax, line_excl_tax):
+    """
+    Turn a price breakdown of exact unit prices into rows of unit prices in
+    cents whose amounts add up to the given line amounts.
+
+    Each group of the breakdown keeps its share of the line (the last group
+    takes what is left), and within a group the cents that do not divide by
+    the quantity go to its first units.
+    """
+    rows = []
+    left_incl, left_excl = line_incl_tax, line_excl_tax
+    for position, (unit_incl, unit_excl, quantity) in enumerate(breakdown):
+        if position == len(breakdown) - 1:
+            group_incl, group_excl = left_incl, left_excl
+        else:
+            group_incl = min(to_cents(unit_incl * quantity), left_incl)
+            group_excl = min(to_cents(unit_excl * quantity), left_excl)
+        left_incl -= group_incl
+        left_excl -= group_excl
+        price_incl, extra_incl = share_in_cents(group_incl, quantity)
+        price_excl, extra_excl = share_in_cents(group_excl, quantity)
+        cuts = sorted({0, extra_incl, extra_excl, quantity})
+        for start, end in zip(cuts, cuts[1:]):
+            rows.append(
+                (
+                    price_incl + (CENT if start < extra_incl else 0),
+                    price_excl + (CENT if start < extra_excl else 0),
+                    end - start,
+                )
+            )
+    return rows
+
+
+def to_cents(amount):
+    """
+    Round an amount that is about to be stored on an order to cents (half up).
+
+    Prices are carried at four decimal places; the database would otherwise
+    quantize them with the default (banker's) rounding of the decimal context.
+    """
+    if amount is None:
+        return None
+    return round_half_up(D(amount))
+
