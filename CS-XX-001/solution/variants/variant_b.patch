diff --git a/src/oscar/core/money.py b/src/oscar/core/money.py
new file mode 100644
index 0000000..3fb6e60
--- /dev/null
+++ b/src/oscar/core/money.py
@@ -0,0 +1,44 @@
+"""
+Amount conventions.
+
+Unit amounts (unit tax, unit price including tax, per-unit shares of a
+discount) are carried at four decimal places.  Amounts that are shown as
+totals or written to an order are in cents.  Rounding is always half up.
+"""
+from decimal import ROUND_HALF_UP, Decimal
+
+CENT = Decimal("0.01")
+UNIT = Decimal("0.0001")
+
+
+def cents(amount):
+    if amount is None:
+        return None
+    return Decimal(amount).quantize(CENT, rounding=ROUND_HALF_UP)
+
+
+def unit(amount):
+    if amount is None:
+        return None
+    return Decimal(amount).quantize(UNIT, rounding=ROUND_HALF_UP)
+
+
+def allocate(amount, quantity):
+    """Split an amount in cents over ``quantity`` units as ``[(units, price)]``
+    with at most two prices one cent apart."""
+    total = int(cents(amount) / CENT)
+    low, higher = divmod(total, quantity)
+    parts = [(higher, (low + 1) * CENT), (quantity - higher, low * CENT)]
+    return [(units, price) for units, price in parts if units]
+
+
+class StoredAmountsMixin:
+    """Model mixin: amounts are normalised to cents before they are saved, so
+    that what is stored does not depend on how the database adapter rounds."""
+
+    stored_amount_fields = ()
+
+    def save(self, *args, **kwargs):
+        for name in self.stored_amount_fields:
+            setattr(self, name, cents(getattr(self, name)))
+        return super().save(*args, **kwargs)
