+def stored_amounts(data):
+    """Amounts written to the order are in cents, rounded half up."""
+    for name in MONEY_FIELDS:
+        if data.get(name) is not None:
+            data[name] = round_half_up_two_dec(D(data[name]))
+    return data
+
+
+def unit_prices(amount, quantity):
+    """Unit prices in cents for ``quantity`` units that add up to ``amount``."""
+    cent = D("0.01")
+    low = (amount / quantity).quantize(cent, rounding=ROUND_DOWN)
+    higher = int((amount - low * quantity) / cent)
+    return [low + cent] * higher + [low] * (quantity - higher)
+
