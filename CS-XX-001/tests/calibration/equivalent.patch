+def _group_pence(unit_prices, quantities, line_amount):
+    """Allocate the stored line amount in proportion to each group's value."""
+    weights = [max(price, 0) * count for price, count in zip(unit_prices, quantities)]
+    if not any(weights):
+        weights = quantities
+    total_weight = sum(weights)
+    total_pence = int(line_amount * 100)
+    cumulative_weight = D(0)
+    previous_pence = 0
+    for weight in weights:
+        cumulative_weight += weight
+        boundary = (total_pence * cumulative_weight / total_weight).to_integral_value(
+            rounding=ROUND_HALF_UP
+        )
+        current_pence = int(boundary)
+        yield current_pence - previous_pence
+        previous_pence = current_pence
+
