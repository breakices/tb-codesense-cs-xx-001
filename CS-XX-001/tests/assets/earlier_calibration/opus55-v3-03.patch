+    def _get_line_discount_amounts(self, order_line, basket_line):
+        """
+        Round the discount applications of a basket line to two decimal
+        places, so that they add up to the discount recorded on the order
+        line (line price before discounts minus line price after discounts).
+        """
+        discounts = list(basket_line.discounts)
+        if not discounts:
+            return []
+        # Cumulative rounding keeps every amount as close as possible to its
+        # exact value, while the sum equals the rounded total.
+        amounts = []
+        cumulative = D("0.00")
+        rounded_cumulative = D("0.00")
+        for discount in discounts:
+            cumulative += discount.amount
+            new_rounded_cumulative = round_half_up(D(cumulative))
+            amounts.append(new_rounded_cumulative - rounded_cumulative)
+            rounded_cumulative = new_rounded_cumulative
+
+        if all(not d.incl_tax for d in discounts):
+            line_discount = order_line.discount_excl_tax
+        elif all(d.incl_tax for d in discounts):
+            line_discount = order_line.discount_incl_tax
+        else:
+            return amounts
+        if line_discount is not None:
+            # Rounding the line prices may differ by a cent from rounding the
+            # discount itself; assign the difference to the last discount.
+            amounts[-1] += D(line_discount) - rounded_cumulative
+        return amounts
+
