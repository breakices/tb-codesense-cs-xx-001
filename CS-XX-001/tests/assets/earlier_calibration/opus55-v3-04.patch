+"""
+Rounding of monetary amounts:
+
+* unit level amounts (unit tax, unit price incl. tax) carry 4 decimal places
+* line level amounts are rounded half up to 2 decimal places, once, from their
+  exact value
+* totals are the sum of the (rounded) amounts they consist of
+"""
+
+from decimal import Decimal as D
+
+from django.test import TestCase
+from django.test.utils import override_settings
+
+from oscar.apps.basket.models import Basket
+from oscar.apps.checkout import calculators
+from oscar.apps.checkout.applicator import SurchargeApplicator
+from oscar.apps.checkout.surcharges import FlatCharge, PercentageCharge
+from oscar.apps.offer import models
+from oscar.apps.offer.applicator import Applicator
+from oscar.apps.order.utils import OrderCreator
+from oscar.apps.partner import strategy
+from oscar.apps.shipping.methods import FixedPrice
+from oscar.templatetags.currency_filters import currency
+from oscar.test import factories
+from oscar.test.basket import add_product
+
+TWO_PLACES = D("0.01").as_tuple().exponent
+
+
+class HalfPointFiveRate(strategy.UK):
+    rate = D("0.175")
+
+
+def create_basket(price, quantity, strategy_class=strategy.UK):
+    basket = Basket.objects.create()
+    basket.strategy = strategy_class()
+    add_product(basket, D(price), quantity)
+    return basket
+
+
+def apply_percentage_offer(basket, percentage):
+    product_range = models.Range.objects.create(
+        name="All products", includes_all_products=True
+    )
+    condition = models.CountCondition.objects.create(
+        range=product_range, type=models.Condition.COUNT, value=1
+    )
+    benefit = models.Benefit.objects.create(
+        range=product_range, type=models.Benefit.PERCENTAGE, value=D(percentage)
+    )
+    factories.create_offer(condition=condition, benefit=benefit)
+    Applicator().apply(basket)
+
+
+def assert_two_places(testcase, *amounts):
+    for amount in amounts:
+        testcase.assertEqual(amount.as_tuple().exponent, TWO_PLACES, amount)
+
+
+class TestUnitPrices(TestCase):
+    def test_unit_tax_has_four_decimal_places(self):
+        basket = create_basket("0.01", 1)
+        line = basket.all_lines()[0]
+        self.assertEqual(line.unit_tax, D("0.0020"))
+        self.assertEqual(line.unit_price_incl_tax, D("0.0120"))
+
+    def test_unit_tax_is_rounded_half_up(self):
+        # 1.99 * 0.175 = 0.34825
+        basket = create_basket("1.99", 1, HalfPointFiveRate)
+        line = basket.all_lines()[0]
+        self.assertEqual(line.unit_tax, D("0.3483"))
+
+
+class TestLinePrices(TestCase):
+    def test_tax_is_not_lost_for_cheap_products(self):
+        basket = create_basket("0.01", 100)
+        line = basket.all_lines()[0]
+        self.assertEqual(line.line_tax, D("0.20"))
+        self.assertEqual(line.line_price_incl_tax, D("1.20"))
+        self.assertEqual(basket.total_tax, D("0.20"))
+        self.assertEqual(basket.total_incl_tax, D("1.20"))
+        self.assertEqual(basket.total_excl_tax, D("1.00"))
+
+    def test_line_prices_are_rounded_once(self):
+        # unit incl tax: 1.99 + 0.3483 = 2.3383; 10 units = 23.383
+        basket = create_basket("1.99", 10, HalfPointFiveRate)
+        line = basket.all_lines()[0]
+        self.assertEqual(line.line_price_incl_tax, D("23.38"))
+        self.assertEqual(line.line_tax, D("3.48"))
+
+    def test_line_prices_round_half_up(self):
+        # 0.03 + 0.00525 -> 0.0353; 0.0353 * 50 = 1.765 -> 1.77
+        basket = create_basket("0.03", 50, HalfPointFiveRate)
+        line = basket.all_lines()[0]
+        self.assertEqual(line.line_price_incl_tax, D("1.77"))
+
+    def test_no_tax_strategy_is_unchanged(self):
+        basket = create_basket("9.99", 3, strategy.Default)
+        self.assertEqual(basket.total_excl_tax, D("29.97"))
+        self.assertEqual(basket.total_incl_tax, D("29.97"))
+        self.assertEqual(basket.total_tax, D("0.00"))
+
+    def test_deferred_tax_strategy_is_unchanged(self):
+        basket = create_basket("9.99", 3, strategy.US)
+        self.assertEqual(basket.total_excl_tax, D("29.97"))
+        self.assertFalse(basket.is_tax_known)
+
+    def test_stored_line_price_does_not_trigger_price_change_warning(self):
+        basket = create_basket("1.99", 1, HalfPointFiveRate)
+        line = basket.all_lines()[0]
+        self.assertEqual(line.price_incl_tax, D("2.34"))
+        self.assertIsNone(line.get_warning())
+        line.refresh_from_db()
+        self.assertIsNone(line.get_warning())
+
+
+class BasketConsistencyMixin:
+    def assert_consistent(self, basket):
+        lines = list(basket.all_lines())
+        assert_two_places(
+            self,
+            basket.total_excl_tax,
+            basket.total_incl_tax,
+            basket.total_tax,
+            basket.total_discount,
+            basket.total_incl_tax_excl_discounts,
+            basket.total_excl_tax_excl_discounts,
+            *[line.line_price_incl_tax_incl_discounts for line in lines],
+            *[line.line_price_excl_tax_incl_discounts for line in lines],
+        )
+        self.assertEqual(
+            basket.total_incl_tax,
+            sum(line.line_price_incl_tax_incl_discounts for line in lines),
+        )
+        self.assertEqual(
+            basket.total_excl_tax,
+            sum(line.line_price_excl_tax_incl_discounts for line in lines),
+        )
+        self.assertEqual(
+            basket.total_incl_tax - basket.total_excl_tax, basket.total_tax
+        )
+
+
+class TestBasketWithPercentageOffer(BasketConsistencyMixin, TestCase):
+    @override_settings(OSCAR_OFFERS_INCL_TAX=True)
+    def test_offer_on_tax_inclusive_prices(self):
+        basket = create_basket("9.99", 3)
+        apply_percentage_offer(basket, "15")
+        self.assert_consistent(basket)
+        # 3 * 11.988 = 35.964; discount 5.3946; 30.5694 -> 30.57
+        self.assertEqual(basket.total_incl_tax, D("30.57"))
+        self.assertEqual(basket.total_incl_tax_excl_discounts, D("35.96"))
+        self.assertEqual(
+            basket.total_incl_tax_excl_discounts - basket.total_incl_tax,
+            basket.total_discount,
+        )
+
+    def test_offer_on_tax_exclusive_prices(self):
+        basket = create_basket("9.99", 3)
+        apply_percentage_offer(basket, "15")
+        self.assert_consistent(basket)
+        self.assertEqual(
+            basket.total_excl_tax_excl_discounts - basket.total_excl_tax,
+            basket.total_discount,
+        )
+
+    @override_settings(OSCAR_OFFERS_INCL_TAX=True)
+    def test_offer_with_half_point_rate(self):
+        basket = create_basket("1.99", 7, HalfPointFiveRate)
+        apply_percentage_offer(basket, "15")
+        self.assert_consistent(basket)
