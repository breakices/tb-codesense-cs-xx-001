+class TestOrderAmounts(BasketConsistencyMixin, TestCase):
+    def place_order(self, basket, shipping_method, surcharges=()):
+        class Applicator(SurchargeApplicator):
+            def get_surcharges(self, basket, **kwargs):
+                return surcharges
+
+        shipping_charge = shipping_method.calculate(basket)
+        surcharges = Applicator().get_applicable_surcharges(
+            basket, shipping_charge=shipping_charge
+        )
+        total = calculators.OrderTotalCalculator().calculate(
+            basket=basket, shipping_charge=shipping_charge, surcharges=surcharges
+        )
+        order = OrderCreator().place_order(
+            basket=basket,
+            total=total,
+            shipping_method=shipping_method,
+            shipping_charge=shipping_charge,
+            surcharges=surcharges,
+        )
+        order.refresh_from_db()
+        return order
+
+    def assert_order_consistent(self, order):
+        lines = list(order.lines.all())
+        surcharges = list(order.surcharges.all())
+        for field in ("incl_tax", "excl_tax"):
+            self.assertEqual(
+                getattr(order, "total_%s" % field),
+                sum(getattr(line, "line_price_%s" % field) for line in lines)
+                + getattr(order, "shipping_%s" % field)
+                + sum(getattr(charge, field) for charge in surcharges),
+            )
+        for line in lines:
+            prices = list(line.prices.all())
+            if line.quantity == 1:
+                self.assertEqual(len(prices), 1)
+                self.assertEqual(prices[0].price_incl_tax, line.line_price_incl_tax)
+                self.assertEqual(prices[0].price_excl_tax, line.line_price_excl_tax)
+            discounts = list(line.discounts.all())
+            if discounts:
+                if discounts[0].is_incl_tax:
+                    before = line.line_price_before_discounts_incl_tax
+                    after = line.line_price_incl_tax
+                else:
+                    before = line.line_price_before_discounts_excl_tax
+                    after = line.line_price_excl_tax
+                self.assertEqual(before - after, sum(d.amount for d in discounts))
+
+    def test_order_amounts_match_basket(self):
+        basket = create_basket("0.01", 100)
+        order = self.place_order(
+            basket,
+            FixedPrice(D("4.99"), D("5.99")),
+            (PercentageCharge(percentage=D("2.5")), FlatCharge(D("1"), D("1.2"))),
+        )
+        self.assertEqual(order.total_incl_tax, D("1.20") + D("5.99") + D("0.18") + D("1.20"))
+        self.assert_order_consistent(order)
+
+    @override_settings(OSCAR_OFFERS_INCL_TAX=True)
+    def test_single_item_line_matches_its_price_breakdown(self):
+        basket = create_basket("1.99", 1, HalfPointFiveRate)
+        add_product(basket, D("9.99"), 3)
+        apply_percentage_offer(basket, "15")
+        order = self.place_order(basket, FixedPrice(D("4.99"), D("5.99")))
+        self.assert_order_consistent(order)
+
+    def test_single_item_line_matches_its_price_breakdown_excl_tax_offer(self):
+        basket = create_basket("1.99", 1, HalfPointFiveRate)
+        add_product(basket, D("9.99"), 3)
+        apply_percentage_offer(basket, "15")
+        order = self.place_order(basket, FixedPrice(D("4.99"), D("5.99")))
+        self.assert_order_consistent(order)
+        line = order.lines.get(quantity=1)
+        self.assertEqual(line.unit_price_incl_tax, D("2.34"))
