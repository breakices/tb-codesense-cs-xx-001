+def round_money(value):
+    """
+    Round an amount (half up) to two decimal places, as should be done for
+    all amounts that are presented to the outside world (line prices,
+    totals, amounts stored on orders, ...).
+
+    ``None`` is passed through.  Integers (e.g. a ``0`` resulting from
+    ``max(0, ...)``) are accepted as well.
+
+    Values computed by dividing by a ratio (e.g. a tax ratio) may carry noise
+    in the last of Decimal's 28 significant digits, which could push an
+    amount lying exactly on a half cent to the wrong side.  That noise is
+    removed before rounding, so that the result equals rounding the exact
+    value once.
+
+    >>> round_money(decimal.Decimal('30.5745'))
+    Decimal('30.57')
+    >>> round_money(decimal.Decimal('9.0049999999999999999999999999'))
+    Decimal('9.01')
+    """
+    if value is None:
+        return None
+    value = decimal.Decimal(value)
+    if not value.is_finite():
+        return value
+    try:
+        value = value.quantize(decimal.Decimal("1E-12"), decimal.ROUND_HALF_UP)
+    except decimal.InvalidOperation:
+        # Too large to carry 12 decimal places; nothing to clean up
+        pass
+    return round_half_up(value)
+
