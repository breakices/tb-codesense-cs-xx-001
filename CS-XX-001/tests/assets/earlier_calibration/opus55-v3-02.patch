+"""Money rounding: half up, 4dp unit prices, 2dp line amounts and totals."""
+from decimal import Decimal as D
+import pytest
+from oscar.apps.partner import strategy
+from oscar.apps.order.utils import OrderCreator
+from oscar.apps.shipping.methods import FixedPrice
+from oscar.apps.checkout.calculators import OrderTotalCalculator
+from oscar.test import factories
+from oscar.apps.offer.applicator import Applicator
+from oscar.templatetags.currency_filters import currency
+
+
+class UK(strategy.UK):
+    pass
+
+class Rate175(strategy.UK):
+    rate = D("0.175")
+
+
+def make_basket(price, qty, strat=UK):
+    basket = factories.BasketFactory()
+    basket.strategy = strat()
+    product = factories.create_product(price=price)
+    basket.add_product(product, qty)
+    return basket, product
+
+
+@pytest.mark.django_db
+def test_small_price_tax():
+    basket, _ = make_basket(D("0.01"), 100)
+    assert basket.total_tax == D("0.20")
+    assert basket.total_incl_tax == D("1.20")
+
+
+@pytest.mark.django_db
+@pytest.mark.parametrize("incl", [True, False])
+def test_promo_basket(incl, settings):
+    settings.OSCAR_OFFERS_INCL_TAX = incl
+    basket, product = make_basket(D("9.99"), 3)
+    rng = factories.RangeFactory(includes_all_products=True)
+    cond = factories.ConditionFactory(range=rng, type="Count", value=1)
+    ben = factories.BenefitFactory(range=rng, type="Percentage", value=15)
+    offer = factories.ConditionalOfferFactory(condition=cond, benefit=ben)
+    Applicator().apply_offers(basket, [offer])
+    line = basket.all_lines()[0]
+    for v in (basket.total_incl_tax, basket.total_excl_tax, basket.total_tax, basket.total_discount, basket.total_incl_tax_excl_discounts):
+        assert v == v.quantize(D("0.01"))
+    if incl:
+        assert basket.total_incl_tax_excl_discounts - basket.total_incl_tax == basket.total_discount
+    else:
+        assert basket.total_excl_tax_excl_discounts - basket.total_excl_tax == basket.total_discount
+    assert basket.total_incl_tax - basket.total_excl_tax == basket.total_tax
+    ship = FixedPrice(D("2.995"), D("3.5945"))
+    charge = ship.calculate(basket)
+    total = OrderTotalCalculator().calculate(basket, charge)
+    order = OrderCreator().place_order(basket=basket, total=total, shipping_method=ship, shipping_charge=charge)
+    order.refresh_from_db()
+    ol = order.lines.get()
+    assert order.total_incl_tax == ol.line_price_incl_tax + order.shipping_incl_tax
+    assert order.total_excl_tax == ol.line_price_excl_tax + order.shipping_excl_tax
+    assert sum(ol.discounts.values_list("amount", flat=True)) == (ol.discount_incl_tax if incl else ol.discount_excl_tax)
+
+
+@pytest.mark.django_db
+@pytest.mark.parametrize("incl", [True, False])
+def test_single_item_matches_breakdown(incl, settings):
+    settings.OSCAR_OFFERS_INCL_TAX = incl
+    basket, product = make_basket(D("9.99"), 1, Rate175)
+    rng = factories.RangeFactory(includes_all_products=True)
+    cond = factories.ConditionFactory(range=rng, type="Count", value=1)
+    ben = factories.BenefitFactory(range=rng, type="Percentage", value=15)
+    offer = factories.ConditionalOfferFactory(condition=cond, benefit=ben)
+    Applicator().apply_offers(basket, [offer])
+    ship = FixedPrice(D("0"), D("0"))
+    charge = ship.calculate(basket)
+    total = OrderTotalCalculator().calculate(basket, charge)
+    order = OrderCreator().place_order(basket=basket, total=total, shipping_method=ship, shipping_charge=charge)
+    ol = order.lines.get(); ol.refresh_from_db()
+    lp = ol.prices.get()
+    assert (lp.price_incl_tax, lp.price_excl_tax) == (ol.line_price_incl_tax, ol.line_price_excl_tax)
+
+
+def test_currency_half_up():
+    assert currency(D("1.005"), "GBP") == "£1.01"
+    assert currency(D("1.015"), "GBP") == "£1.02"
