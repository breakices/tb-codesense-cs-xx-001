+def _round_half_up_for_display(value, currency_code, kwargs):
+    """
+    Babel rounds half even when it reduces a value to the number of decimal
+    places of the currency.  Monetary amounts must be rounded half up, so do
+    that beforehand.
+    """
+    if not kwargs.get("currency_digits", True) or not kwargs.get(
+        "decimal_quantization", True
+    ):
+        return value
+    if not value.is_finite():
+        return value
+    try:
+        precision = get_currency_precision(currency_code)
+    except Exception:  # pylint: disable=broad-except
+        return value
+    exponent = D(1).scaleb(-precision)
+    if value.as_tuple().exponent < -precision:
+        value = value.quantize(exponent, rounding=ROUND_HALF_UP)
+    return value
