+    def _get_line_discount_amounts(self, basket_line):
+        """
+        Return the amount (rounded to two decimal places) to record for each
+        discount application of the basket line.
+
+        The amounts add up to the line's discount, i.e. the line price before
+        discounts minus the line price after discounts, as written to the
+        order line.
+        """
+        discounts = list(basket_line.discounts)
+        if not discounts:
+            return []
+        amounts = [round_half_up(D(discount.amount)) for discount in discounts]
+        try:
+            line_discount = basket_line.line_discount
+        except Exception:  # pylint: disable=broad-except
+            return amounts
+        difference = line_discount - sum(amounts)
+        if difference:
+            # Put the rounding difference on the last (largest possible)
+            # discount application, so the parts add up to the line discount
+            index = max(range(len(amounts)), key=lambda i: (amounts[i], i))
+            amounts[index] += difference
+        return amounts
+
