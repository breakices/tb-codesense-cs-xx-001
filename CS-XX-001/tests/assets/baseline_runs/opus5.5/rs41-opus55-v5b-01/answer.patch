+    @staticmethod
+    def _split_line_price(total_incl_tax, total_excl_tax, quantity):
+        """
+        Split penny amounts over ``quantity`` items, returning
+        (unit_price_incl_tax, unit_price_excl_tax, quantity) tuples whose unit
+        prices are whole pennies and add up exactly to the passed totals.
+        """
+        penny = D("0.01")
+        base_incl_tax = (total_incl_tax / quantity).quantize(penny, ROUND_FLOOR)
+        base_excl_tax = (total_excl_tax / quantity).quantize(penny, ROUND_FLOOR)
+        # Number of items that have to carry an extra penny
+        extra_incl_tax = int((total_incl_tax - base_incl_tax * quantity) / penny)
+        extra_excl_tax = int((total_excl_tax - base_excl_tax * quantity) / penny)
+        both = min(extra_incl_tax, extra_excl_tax)
+        candidates = [
+            (base_incl_tax + penny, base_excl_tax + penny, both),
+            (base_incl_tax + penny, base_excl_tax, extra_incl_tax - both),
+            (base_incl_tax, base_excl_tax + penny, extra_excl_tax - both),
+            (
+                base_incl_tax,
+                base_excl_tax,
+                quantity - max(extra_incl_tax, extra_excl_tax),
+            ),
+        ]
+        return [c for c in candidates if c[2] > 0]
+
