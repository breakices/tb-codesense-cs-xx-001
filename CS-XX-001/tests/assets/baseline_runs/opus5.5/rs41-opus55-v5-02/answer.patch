+    @staticmethod
+    def _round(amount):
+        if amount is None:
+            return None
+        return round_half_up(D(amount))
+
+    @classmethod
+    def _allocate_cents(cls, exact_amounts, target):
+        """
+        Round each of ``exact_amounts`` (one per unit) to whole cents so that
+        they add up exactly to ``target``.  Units start off rounded half up;
+        any remaining cents are handed out to (or taken from) the units whose
+        rounding moved them furthest from their exact value.
+        """
+        cent = D("0.01")
+        rounded = [cls._round(amount) for amount in exact_amounts]
+        if target is None or not rounded:
+            return rounded
+        diff = int((cls._round(target) - sum(rounded)) / cent)
+        if diff == 0:
+            return rounded
+        step = cent if diff > 0 else -cent
+        errors = [exact - r for exact, r in zip(exact_amounts, rounded)]
+        # Most under-rounded units first when adding cents, most over-rounded
+        # units first when removing them.  Ties go to the earliest unit.
+        order = sorted(
+            range(len(rounded)),
+            key=lambda i: (-errors[i] if diff > 0 else errors[i], i),
+        )
+        for n in range(abs(diff)):
+            rounded[order[n % len(order)]] += step
+        return rounded
+
+    def _allocate_line_prices(self, breakdown, line_total_incl_tax, line_total_excl_tax):
+        """
+        Convert a basket line price breakdown (which may carry more than two
+        decimal places) into whole-cent unit prices whose sum equals the
+        amounts recorded on the order line.
+        """
+        breakdown = list(breakdown)
+        units_incl, units_excl, groups = [], [], []
+        for group, (price_incl_tax, price_excl_tax, quantity) in enumerate(breakdown):
+            quantity = int(quantity)
+            units_incl.extend([D(price_incl_tax)] * quantity)
+            units_excl.extend([D(price_excl_tax)] * quantity)
+            groups.extend([group] * quantity)
+
+        if not groups:
+            return [
+                (self._round(incl), self._round(excl), quantity)
+                for incl, excl, quantity in breakdown
+            ]
+
+        units_incl = self._allocate_cents(units_incl, line_total_incl_tax)
+        units_excl = self._allocate_cents(units_excl, line_total_excl_tax)
+
+        allocated = []
+        for group, incl, excl in zip(groups, units_incl, units_excl):
+            if allocated and allocated[-1][:3] == [group, incl, excl]:
+                allocated[-1][3] += 1
+            else:
+                allocated.append([group, incl, excl, 1])
+        return [(incl, excl, quantity) for _, incl, excl, quantity in allocated]
+
