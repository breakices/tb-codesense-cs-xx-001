+ZERO = D("0.00")
+PENNY = D("0.01")
+
+
+def _round_or_none(amount):
+    """
+    Round a monetary amount to whole pence (half up), leaving ``None`` alone.
+    """
+    if amount is None:
+        return None
+    return round_half_up(D(amount))
+
+
+def _split_total(total, quantity):
+    """
+    Split a two-decimal ``total`` over ``quantity`` units so that the unit
+    amounts (also two decimals) add up exactly to ``total``.
+
+    Returns a list of ``(unit_amount, count)`` tuples, larger amounts first.
+    """
+    cents = int((total / PENNY).to_integral_value())
+    base, extra = divmod(cents, quantity)
+    parts = []
+    if extra:
+        parts.append(((base + 1) * PENNY, extra))
+    if quantity - extra:
+        parts.append((base * PENNY, quantity - extra))
+    return parts
+
+
+def _merge_splits(incl_parts, excl_parts):
+    """
+    Combine two splits of the same quantity into
+    ``(unit_incl_tax, unit_excl_tax, count)`` tuples.
+    """
+    incl_parts, excl_parts = list(incl_parts), list(excl_parts)
+    merged = []
+    while incl_parts and excl_parts:
+        (incl, incl_qty), (excl, excl_qty) = incl_parts[0], excl_parts[0]
+        qty = min(incl_qty, excl_qty)
+        merged.append((incl, excl, qty))
+        if incl_qty == qty:
+            incl_parts.pop(0)
+        else:
+            incl_parts[0] = (incl, incl_qty - qty)
+        if excl_qty == qty:
+            excl_parts.pop(0)
+        else:
+            excl_parts[0] = (excl, excl_qty - qty)
+    return merged
+
 
